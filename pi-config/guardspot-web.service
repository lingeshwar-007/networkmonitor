[Unit]
Description=GuardSpot Web Dashboard
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/networkmonitor
ExecStart=/home/pi/networkmonitor/venv/bin/python3 app.py
Restart=on-failure
RestartSec=5
EnvironmentFile=-/etc/guardspot/guardspot.env

[Install]
WantedBy=multi-user.target
